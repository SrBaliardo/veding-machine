{
  "name": "medalhive",
  "version": "1.1.1",
  "description": "MedalHive — totem de medalhas comemorativas",
  "main": "electron/main.cjs",
  "author": "HIVETRON Technology",
  "license": "ISC",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "dev:react": "vite",
    "start": "node scripts/start.cjs",
    "build": "vite build",
    "build:react": "vite build",
    "package": "node scripts/ensure-electron.cjs && node scripts/make-icon.cjs && electron-builder --win nsis --x64",
    "package:dir": "node scripts/ensure-electron.cjs && node scripts/make-icon.cjs && electron-builder --win --x64 --dir",
    "full-build": "npm run build && npm run package",
    "lint": "eslint src/medalhive src/main.jsx electron scripts tests vite.config.js",
    "test": "node --test tests/store.test.cjs",
    "test:ui": "node scripts/smoke.cjs"
  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-qr-code": "2.0.18",
    "react-router-dom": "7.18.4",
    "react-simple-keyboard": "3.8.115"
  },
  "devDependencies": {
    "@eslint/js": "9.33.0",
    "@vitejs/plugin-react": "5.0.0",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "eslint": "9.34.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.3.0",
    "vite": "7.3.7"
  },
  "build": {
    "appId": "com.hivetron.medalhive",
    "productName": "MedalHive",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/*.cjs",
      "package.json"
    ],
    "directories": {
      "output": "release/medalhive"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "executableName": "MedalHive",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "MedalHive",
      "deleteAppDataOnUninstall": false
    },
    "artifactName": "MedalHive-Setup-${version}.${ext}",
    "electronDist": "node_modules/electron/dist"
  }
}
